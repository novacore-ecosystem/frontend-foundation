{
  "name": "@novacore/frontend-foundation",
  "version": "0.1.0",
  "description": "Framework-agnostic frontend foundation: tenant bootstrap, i18n resolution, date/number/currency/phone/string utilities.",
  "type": "module",
  "main": "./dist/index.js",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./http": {
      "types": "./dist/http/index.d.ts",
      "import": "./dist/http/index.js"
    },
    "./realtime": {
      "types": "./dist/realtime/index.d.ts",
      "import": "./dist/realtime/index.js"
    },
    "./package.json": "./package.json"
  },
  "files": [
    "dist"
  ],
  "sideEffects": false,
  "scripts": {
    "build": "tsup",
    "dev": "tsup --watch",
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "tsc --noEmit",
    "clean": "rm -rf dist"
  },
  "keywords": [
    "novacore",
    "frontend",
    "foundation",
    "i18n",
    "utilities"
  ],
  "author": "",
  "license": "UNLICENSED",
  "private": true,
  "packageManager": "pnpm@10.15.0",
  "devDependencies": {
    "tsup": "^8.3.5",
    "typescript": "^5.7.3",
    "vitest": "^2.1.8"
  },
  "dependencies": {
    "libphonenumber-js": "^1.13.10",
    "axios": "^1.7.9",
    "@microsoft/signalr": "^8.0.7"
  }
}
